<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="."/>
        <exclude domain="database" path="pokie_talkie.db"/>
        <exclude domain="database" path="pokie_talkie.db-wal"/>
        <exclude domain="database" path="pokie_talkie.db-shm"/>
        <exclude domain="sharedpref" path="pokie_user_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="."/>
        <exclude domain="database" path="pokie_talkie.db"/>
        <exclude domain="database" path="pokie_talkie.db-wal"/>
        <exclude domain="database" path="pokie_talkie.db-shm"/>
        <exclude domain="sharedpref" path="pokie_user_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
